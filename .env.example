# Copy this file to .env for local development.
# Docker Compose reads .env automatically. Keep real secrets out of git.

# Recommended local MySQL values. Change passwords for any shared machine.
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=chatmvp
MYSQL_USER=chatmvp
MYSQL_PASSWORD=change-me-app-password

# Required when running the application locally.
JWT_SECRET=change-me-to-at-least-32-ascii-characters
SPRING_PROFILES_ACTIVE=dev
